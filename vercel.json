{
  "version": 2,
  "rewrites": [
    { "source": "/api/manga/:endpoint", "destination": "/api/manga.js?endpoint=:endpoint" },
    { "source": "/api/:endpoint", "destination": "/api/manga.js?endpoint=:endpoint" }
  ],
  "functions": {
    "api/manga.js": {
      "includeFiles": "crawler.cjs"
    }
  }
}
